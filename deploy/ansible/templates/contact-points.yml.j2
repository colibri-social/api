apiVersion: 1

contactPoints:
  - orgId: 1
    name: colibri-webhook
    receivers:
      - uid: colibri-webhook
        type: webhook
        settings:
          url: {{ alert_webhook_url | to_json }}
          httpMethod: POST

policies:
  - orgId: 1
    receiver: colibri-webhook
    group_by: ["alertname", "node"]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
