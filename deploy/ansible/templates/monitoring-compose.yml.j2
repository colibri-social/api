services:
  prometheus:
    image: {{ prometheus_image }}
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention | default('90d') }}
      - --web.enable-remote-write-receiver
    ports:
      - "{{ tailnet_ip.stdout }}:9090:9090"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus

  loki:
    image: {{ loki_image }}
    restart: unless-stopped
    command:
      - -config.file=/etc/loki/loki.yml
    ports:
      - "{{ tailnet_ip.stdout }}:3101:3100"
    volumes:
      - ./loki/loki.yml:/etc/loki/loki.yml:ro
      - loki-data:/loki

  grafana:
    image: {{ grafana_image }}
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_SERVER_ROOT_URL: http://{{ tailnet_ip.stdout }}:3300
    ports:
      - "{{ tailnet_ip.stdout }}:3300:3000"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - grafana-data:/var/lib/grafana
    secrets:
      - grafana_admin_password
    depends_on:
      - prometheus
      - loki

secrets:
  grafana_admin_password:
    file: ./grafana-admin-password

volumes:
  prometheus-data:
  loki-data:
  grafana-data:
