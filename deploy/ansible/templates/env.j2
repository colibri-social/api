IMAGE={{ image }}
NODE_ID={{ node_id }}
NODE_REGION={{ node_region }}
NODE_PUBLIC_URL={{ public_url }}
NODE_TAILNET_URL=http://{{ tailnet_ip.stdout }}:{{ cluster_port }}
TAILNET_IP={{ tailnet_ip.stdout }}
MAIN_NODE_URL={{ main_tailnet_url }}
{% if join_token is defined and join_token %}
CLUSTER_JOIN_TOKEN={{ join_token }}
{% endif %}
CLUSTER_PORT={{ cluster_port }}
PUBLIC_HOST={{ public_host }}
{% if 'voice' in node_roles %}
SFU_ANNOUNCED_IP={{ ansible_host }}
SFU_RTC_PORT={{ rtc_port }}
SFU_WORKER_COUNT={{ rtc_workers }}
{% endif %}
{% if postgres %}
DATABASE_URL=postgres://{{ db_user | urlencode | replace('/', '%2F') }}:{{ db_password | urlencode | replace('/', '%2F') }}@{{ primary_host }}:5432/{{ db_name }}
DATABASE_READ_URL=postgres://{{ db_user | urlencode | replace('/', '%2F') }}:{{ db_password | urlencode | replace('/', '%2F') }}@postgres:5432/{{ db_name }}
PRIMARY_HOST={{ primary_host }}
REPLICATION_PASSWORD={{ replication_password }}
REPLICATION_SLOT={{ node_id | replace('-', '_') }}
{% else %}
DATABASE_URL=postgres://{{ db_user | urlencode | replace('/', '%2F') }}:{{ db_password | urlencode | replace('/', '%2F') }}@{{ primary_host }}:5432/{{ db_name }}
{% endif %}
