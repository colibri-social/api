services:
  appview:
    image: ${IMAGE}
    restart: unless-stopped
    stop_grace_period: {{ (drain_minutes | int) + 2 }}m
    env_file:
      - path: .env
    environment:
      HOST: 0.0.0.0
      PORT: 3000
      NODE_SECRET_FILE: /data/node-secret
      BLOB_DISK_CACHE_DIR: /data/blob-cache
      METRICS_HOST: 0.0.0.0
    ports:
      - "${TAILNET_IP}:${CLUSTER_PORT}:${CLUSTER_PORT}"
{% if 'voice' in node_roles %}
      - "{{ rtc_port }}-{{ (rtc_port | int) + (rtc_workers | int) - 1 }}:{{ rtc_port }}-{{ (rtc_port | int) + (rtc_workers | int) - 1 }}/udp"
      - "{{ rtc_port }}-{{ (rtc_port | int) + (rtc_workers | int) - 1 }}:{{ rtc_port }}-{{ (rtc_port | int) + (rtc_workers | int) - 1 }}/tcp"
{% endif %}
    volumes:
      - appview-data:/data
{% if postgres %}
    depends_on:
      postgres:
        condition: service_healthy
{% endif %}

  caddy:
    image: caddy:2.10
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./caddy-sites:/etc/caddy/sites:ro
      - caddy-data:/data
    depends_on:
      - appview

  alloy:
    image: ${ALLOY_IMAGE:-grafana/alloy:v1.21.2}
    profiles: [monitoring]
    restart: unless-stopped
    command: ["run", "--storage.path=/var/lib/alloy/data", "/etc/alloy"]
    pid: host
    environment:
      PROMETHEUS_REMOTE_WRITE_URL: ${PROMETHEUS_REMOTE_WRITE_URL:-}
      NODE_ID: ${NODE_ID}
      NODE_REGION: ${NODE_REGION:-}
{% if postgres %}
      POSTGRES_EXPORTER_DSN: "postgres://{{ db_user | urlencode | replace('/', '%2F') }}:{{ db_password | urlencode | replace('/', '%2F') }}@postgres:5432/{{ db_name }}?sslmode=disable"
{% endif %}
    volumes:
      - ./alloy:/etc/alloy:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro,rslave
      - /var/lib/colibri/metrics:/host/textfile:ro
      - alloy-data:/var/lib/alloy/data
{% if postgres %}

  postgres:
    image: {{ postgres_image | default('ghcr.io/colibri-social/postgres:18') }}
    restart: unless-stopped
    entrypoint: ["/bin/sh", "/replica-entrypoint.sh"]
    environment:
{% if backup_repo_host is defined %}
      PGBACKREST_STANZA: colibri
      PGBACKREST_PG1_PATH: /var/lib/postgresql/18/docker
      PGBACKREST_PG1_USER: {{ db_user | to_json }}
      PGBACKREST_REPO1_TYPE: sftp
      PGBACKREST_REPO1_SFTP_HOST: {{ backup_repo_host | to_json }}
      PGBACKREST_REPO1_SFTP_HOST_PORT: "{{ backup_repo_port }}"
      PGBACKREST_REPO1_SFTP_HOST_USER: {{ backup_repo_user | to_json }}
      PGBACKREST_REPO1_SFTP_HOST_KEY_CHECK_TYPE: accept-new
      PGBACKREST_REPO1_SFTP_HOST_KEY_HASH_TYPE: sha256
      PGBACKREST_REPO1_SFTP_PRIVATE_KEY_FILE: /var/lib/postgresql/.pgbackrest/key
      PGBACKREST_REPO1_SFTP_PUBLIC_KEY_FILE: /var/lib/postgresql/.pgbackrest/key.pub
      PGBACKREST_REPO1_PATH: {{ backup_repo_path | to_json }}
      PGBACKREST_REPO1_RETENTION_FULL: "4"
      PGBACKREST_REPO1_CIPHER_TYPE: aes-256-cbc
      PGBACKREST_REPO1_CIPHER_PASS: ${BACKUP_CIPHER_PASS}
      PGBACKREST_COMPRESS_TYPE: zst
      PGBACKREST_START_FAST: "y"
{% endif %}
      PRIMARY_HOST: ${PRIMARY_HOST}
      REPLICATION_PASSWORD: ${REPLICATION_PASSWORD}
      REPLICATION_SLOT: ${REPLICATION_SLOT}
    ports:
      - "${TAILNET_IP}:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_user }}"]
      interval: 5s
      timeout: 3s
      retries: 12
      start_period: 6h
    volumes:
      - ./replica-entrypoint.sh:/replica-entrypoint.sh:ro
      - ./backup:/run/backup:ro
      - postgres-data:/var/lib/postgresql
{% endif %}

volumes:
  appview-data:
  caddy-data:
  alloy-data:
{% if postgres %}
  postgres-data:
{% endif %}
