local.file "loki_url" {
	filename = "/etc/alloy/loki-url"
}

loki.write "monitoring" {
	endpoint {
		url = string.trim_space(local.file.loki_url.content)
	}

	external_labels = {
		node   = sys.env("NODE_ID"),
		region = coalesce(sys.env("NODE_REGION"), "default"),
	}
}

discovery.docker "containers" {
	host = "unix:///host/root/run/docker.sock"
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "project"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service", "container"]
		separator     = ";"
		regex         = ";(.*)|(.+);.*"
		replacement   = "$1$2"
		target_label  = "service"
	}
}

loki.source.docker "containers" {
	host          = "unix:///host/root/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.write.monitoring.receiver]
}
