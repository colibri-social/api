{
	"uid": "colibri-voice",
	"title": "Colibri voice",
	"tags": [
		"colibri"
	],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 1,
	"editable": false,
	"refresh": "30s",
	"time": {
		"from": "now-6h",
		"to": "now"
	},
	"templating": {
		"list": [
			{
				"name": "node",
				"label": "Node",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "colibri-prometheus"
				},
				"query": {
					"query": "label_values(colibri_voice_calls, node)",
					"refId": "node"
				},
				"definition": "label_values(colibri_voice_calls, node)",
				"refresh": 2,
				"includeAll": true,
				"multi": true,
				"current": {
					"text": "All",
					"value": "$__all"
				},
				"allValue": ".*"
			}
		]
	},
	"panels": [
		{
			"type": "timeseries",
			"title": "Calls by node",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "sum by (node) (colibri_voice_calls{node=~\"$node\"})",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 1
		},
		{
			"type": "timeseries",
			"title": "Participants by node",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 0,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "sum by (node) (colibri_voice_participants{node=~\"$node\"})",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 2
		},
		{
			"type": "timeseries",
			"title": "SFU bitrate",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 8,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "sum by (node, direction) (colibri_sfu_bitrate_bits_per_second{node=~\"$node\"})",
					"legendFormat": "{{node}} {{direction}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "bps"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 3
		},
		{
			"type": "timeseries",
			"title": "Worst packet loss",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 8,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "max by (node, direction) (colibri_sfu_packet_loss{node=~\"$node\"})",
					"legendFormat": "{{node}} {{direction}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 4
		},
		{
			"type": "timeseries",
			"title": "SFU worker CPU",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 16,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "rate(colibri_sfu_worker_cpu_seconds{node=~\"$node\"}[5m])",
					"legendFormat": "{{node}} worker {{worker}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 5
		},
		{
			"type": "timeseries",
			"title": "Transports by ICE state",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 16,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "sum by (node, ice) (colibri_sfu_transports{node=~\"$node\"})",
					"legendFormat": "{{node}} {{ice}}"
				}
			],
			"fieldConfig": {
				"defaults": {},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 6
		},
		{
			"type": "timeseries",
			"title": "Join time (p95)",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 24,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "histogram_quantile(0.95, sum by (node, le) (rate(colibri_voice_join_duration_seconds_bucket{node=~\"$node\"}[15m])))",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 7
		},
		{
			"type": "timeseries",
			"title": "TURN credentials",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 24,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "sum by (outcome) (rate(colibri_turn_credentials_total[5m]))",
					"legendFormat": "{{outcome}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ops"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 8
		}
	]
}
