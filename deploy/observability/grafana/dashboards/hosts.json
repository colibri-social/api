{
	"uid": "colibri-hosts",
	"title": "Colibri hosts",
	"tags": [
		"colibri"
	],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 2,
	"editable": false,
	"refresh": "30s",
	"time": {
		"from": "now-6h",
		"to": "now"
	},
	"templating": {
		"list": [
			{
				"name": "node",
				"label": "Node",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "colibri-prometheus"
				},
				"query": {
					"query": "label_values(node_load1, node)",
					"refId": "node"
				},
				"definition": "label_values(node_load1, node)",
				"refresh": 2,
				"includeAll": true,
				"multi": true,
				"current": {
					"text": "All",
					"value": "$__all"
				},
				"allValue": ".*"
			}
		]
	},
	"panels": [
		{
			"type": "timeseries",
			"title": "CPU busy",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "1 - avg by (node) (rate(node_cpu_seconds_total{node=~\"$node\",mode=\"idle\"}[5m]))",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 1
		},
		{
			"type": "timeseries",
			"title": "Load (1 min)",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 0,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "node_load1{node=~\"$node\"}",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 2
		},
		{
			"type": "timeseries",
			"title": "Memory used",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 8,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "1 - node_memory_MemAvailable_bytes{node=~\"$node\"} / node_memory_MemTotal_bytes{node=~\"$node\"}",
					"legendFormat": "{{node}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 3
		},
		{
			"type": "timeseries",
			"title": "Disk used",
			"datasource": {
				"type": "prometheus",
				"uid": "colibri-prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 8,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "colibri-prometheus"
					},
					"expr": "1 - node_filesystem_avail_bytes{node=~\"$node\",fstype!~\"erofs|squashfs|iso9660\"} / node_filesystem_size_bytes{node=~\"$node\",fstype!~\"erofs|squashfs|iso9660\"}",
					"legendFormat": "{{node}} {{mountpoint}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"id": 4
		},
