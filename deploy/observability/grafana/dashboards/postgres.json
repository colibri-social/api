					"options": {}
				},
				{
					"id": "organize",
					"options": {
						"excludeByName": {
							"Time": true
						},
						"indexByName": {
							"relname": 0,
							"Value #A": 1,
							"Value #B": 2,
							"Value #C": 3,
							"Value #D": 4,
							"Value #E": 5,
							"Value #F": 6
						},
						"renameByName": {
							"relname": "Table",
							"Value #A": "Rows",
							"Value #B": "Size",
							"Value #C": "Index size",
							"Value #D": "Dead rows",
							"Value #E": "Inserts (1h)",
							"Value #F": "Sequential scans (1h)"
						}
					}
				}
			],
