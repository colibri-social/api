{
	"name": "@colibri-social/lexicons",
	"version": "2.9.0",
	"description": "Colibri lexicon schemas and the types generated from them",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"colibri-source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./lexicons/*": "./lexicons/*"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"lexicons"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/colibri-social/api.git",
		"directory": "packages/lexicons"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc --build",
		"clean": "tsc --build --clean",
		"codegen": "node scripts/codegen.mjs",
		"check-dns": "node scripts/check-dns.mjs",
		"publish-lexicons": "node scripts/publish.mjs",
		"renamespace": "node scripts/renamespace.mjs"
	},
	"dependencies": {
		"@atproto/lex": "catalog:",
		"@atproto/lex-data": "catalog:"
	}
}
