{
	"lexicon": 1,
	"id": "social.colibri.permissionAccount",
	"defs": {
		"main": {
			"type": "permission-set",
			"title": "Your Colibri account",
			"detail": "Read and change your Colibri profile, settings, mutes and read state.",
			"permissions": [
				{
					"type": "permission",
					"resource": "space",
					"spaceType": "social.colibri.actor.preferences",
					"authority": "self",
					"skey": "self",
					"collection": [
						"social.colibri.actor.mute",
						"social.colibri.actor.settings",
						"social.colibri.channel.read"
					],
					"action": ["read", "create", "update", "delete"],
					"manage": ["create", "update"]
				},
				{
					"type": "permission",
					"resource": "repo",
					"collection": ["social.colibri.actor.profile"],
					"action": ["create", "update", "delete"]
				},
				{
					"type": "permission",
					"resource": "rpc",
					"inheritAud": true,
					"lxm": [
						"social.colibri.actor.getProfile",
						"social.colibri.actor.getPreferences",
						"social.colibri.actor.putSettings",
						"social.colibri.actor.putMutes",
						"social.colibri.actor.grantSpaceAccess",
						"social.colibri.actor.listCommunities",
						"social.colibri.actor.setStatus",
						"social.colibri.actor.getDeletionStatus",
						"social.colibri.actor.deleteAccount",
						"social.colibri.server.describeServer",
						"social.colibri.blob.get"
					]
				}
			]
		}
	}
}
