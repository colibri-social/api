{
	"lexicon": 1,
	"id": "social.colibri.permissionNotification",
	"defs": {
		"main": {
			"type": "permission-set",
			"title": "Colibri notifications",
			"detail": "Read your Colibri notifications and mark them as seen.",
			"permissions": [
				{
					"type": "permission",
					"resource": "rpc",
					"inheritAud": true,
					"lxm": [
						"social.colibri.notification.listNotifications",
						"social.colibri.notification.getUnreadCount",
						"social.colibri.notification.getUnseen",
						"social.colibri.notification.updateSeen",
						"social.colibri.notification.updateSeenForMessage"
					]
				}
			]
		}
	}
}
