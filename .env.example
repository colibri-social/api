# Copy to .env. Everything without a default is required.

# identity

# The did:web this AppView answers as. Self-hosters must set their own.
APPVIEW_DID=did:web:appview.example.com
# Where this AppView is reachable from the public internet. The community's PDS
# calls back here on every credential mint, so it has to be reachable.
PUBLIC_URL=https://appview.example.com

# Browser origins allowed to call /xrpc. Comma-separated, or "*" for any origin.
# Unset, development allows http://localhost:4321 and http://127.0.0.1:4321 (the
# Colibri client's dev server) and production allows nothing, so a deployment
# whose client lives on another origin has to name it here.
# CORS_ORIGINS=https://app.example.com

# secp256k1 private key, 64 hex characters. Published in the DID document.
#   openssl ecparam -name secp256k1 -genkey -noout -outform DER | tail -c +8 | head -c 32 | xxd -p -c 32
SIGNING_KEY=

# 32 bytes, base64. Encrypts community passwords at rest. Losing it means every
# community has to have its password reset through the PDS admin API.
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# What social.colibri.beta.server.describeServer reports as this build's flavor.
# "vanilla" is the stock AppView.
# APPVIEW_FLAVOR=vanilla

# A community every user joins after creating their profile for the first time.
# DEFAULT_COMMUNITY_DID=

# storage

# libSQL by default. A postgres:// URL switches driver.
DATABASE_URL=file:./data/colibri.db
# DATABASE_AUTH_TOKEN=
# DATABASE_MAX_CONNECTIONS=20
# A Postgres read replica. Reads go there, writes and transactions go to DATABASE_URL.
# DATABASE_READ_URL=

# node

# What this node runs: main, failover, api, live, voice. Defaults to main,api,live,voice.
# ROLES=main,api,live,voice
# Setting NODE_ID makes this AppView a cluster node: it registers itself, heartbeats and
# shows up in listNodes. Leave it unset for a single AppView.
# NODE_ID=
# NODE_REGION=
# The node's own public URL, such as https://eu-2.nodes.colibri.social. Defaults to PUBLIC_URL.
# NODE_PUBLIC_URL=
# Where other nodes reach this one over the tailnet, on CLUSTER_PORT. Defaults to
# http://<hostname>:<CLUSTER_PORT>. Publish CLUSTER_PORT on the tailnet address only.
# NODE_TAILNET_URL=
# CLUSTER_PORT=3100
# Nodes without the main role link to the main node. MAIN_NODE_URL is its tailnet URL, used
# until the registry names the current main node. CLUSTER_JOIN_TOKEN comes from
# colibri-admin node add and is traded for a secret kept in NODE_SECRET_FILE.
# MAIN_NODE_URL=http://hel-1:3100
# CLUSTER_JOIN_TOKEN=
# NODE_SECRET_FILE=./data/node-secret
# The main node provisions other nodes over SSH with Ansible. It needs these to run
# colibri-admin node add --ip.
# NODE_IMAGE=ghcr.io/colibri-social/api:stable
# SSH_USER=root
# SSH_KEY_FILE=/run/secrets/colibri_ssh_key
# TAILSCALE_AUTH_KEY=
# POSTGRES_REPLICATION_PASSWORD=
# Only for a private image.
# REGISTRY_USER=
# REGISTRY_TOKEN=
# Where the main node's own stack lives, for updating itself.
# STACK_DIR=/opt/colibri
# Minutes between checks for a new NODE_IMAGE. 0 turns rolling updates off.
# UPDATE_POLL_MINUTES=15
# DNS records for new nodes, and pools on an existing load balancer on the API host.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_LB_ID=
# CLOUDFLARE_GEO_REGIONS=lab=ENAM
# Monitoring. colibri-admin monitoring deploy sets PROMETHEUS_REMOTE_WRITE_URL.
# GRAFANA_ADMIN_PASSWORD=
# ALERT_WEBHOOK_URL=
# PROMETHEUS_REMOTE_WRITE_URL=
# PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
# GRAFANA_IMAGE=grafana/grafana:13.2.5
# ALLOY_IMAGE=grafana/alloy:v1.21.2
# LOKI_IMAGE=grafana/loki:3.7.9
# Backups with pgBackRest to an SFTP repository. Put the SSH key in data/backup/key and key.pub.
# POSTGRES_IMAGE=ghcr.io/colibri-social/postgres:18
# BACKUP_REPO_HOST=u123456.your-storagebox.de
# BACKUP_REPO_PORT=23
# BACKUP_REPO_USER=u123456
# BACKUP_REPO_PATH=/home/colibri
# BACKUP_CIPHER_PASS=
# Behind an existing Traefik (for example Dokploy) instead of Caddy, on the main node.
# COMPOSE_FILE=docker-compose.scaled.yml:deploy/traefik/compose.traefik.yml
# TRAEFIK_NETWORK=dokploy-network
# TRAEFIK_CERT_RESOLVER=letsencrypt
# TRAEFIK_ENTRYPOINT=websecure
# API_HOST=
# The status page. KUMA_URL is Uptime Kuma on the tailnet, KUMA_PUBLIC_URL its public host.
# KUMA_URL=
# KUMA_PUBLIC_URL=
# KUMA_USERNAME=
# KUMA_PASSWORD=
# KUMA_STATUS_SLUG=colibri
# KUMA_IMAGE=louislam/uptime-kuma:2.5.7-slim
# Minutes a node waits for clients to move elsewhere before it shuts down. A node with no
# other nodes to send clients to waits 15 seconds.
# DRAIN_GRACE_MINUTES=120

# PDS

# Must be running the spaces alpha: ghcr.io/bluesky-social/atproto:pds-spaces-alpha
PDS_URL=https://pds.example.com
# Without this the AppView serves reads but cannot create a community or repair
# one whose password stopped working.
PDS_ADMIN_PASSWORD=
# PDS_REQUIRES_INVITE=false

# Communities get handles like my-community.${COMMUNITY_HANDLE_DOMAIN}, which
# the PDS answers for, so *.${COMMUNITY_HANDLE_DOMAIN} must resolve to it.
COMMUNITY_HANDLE_DOMAIN=communities.example.com
# COMMUNITY_EMAIL_DOMAIN=

# Lets owners host a community on an account of their own and reconnect after
# moving it to another server. An ES256 private key in PKCS#8 PEM or JWK form,
# generated once and kept. Newlines may be written as \n.
# HOST_OAUTH_PRIVATE_KEY=
# HOST_OAUTH_KEY_ID=host-oauth-1
# Where the browser lands after signing in, such as https://colibri.social/app
# HOST_OAUTH_RETURN_URL=

# network

# PLC_URL=https://plc.directory
# Jetstream v2. Only identity and account events are consumed, to invalidate the
# identity cache and purge deleted accounts.
# JETSTREAM_URL=wss://jetstream.us-west.bsky.network
# JETSTREAM_ENABLED=true

# SYNC_WORKERS=16
# SYNC_SWEEP_SECONDS=300

# Worker threads for commit verification and CAR recovery. 0 runs that work on
# the main thread, which is what a single-core deployment wants.
# SYNC_WORKER_THREADS=0
# SERVICE_AUTH_MAX_LIFETIME_SECONDS=300

# optional features

# Web Push. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Android push.
# FCM_SERVICE_ACCOUNT_JSON=

# iOS and macOS push. APNS_KEY is the .p8 auth key, either base64-encoded or
# as PEM with newlines written as \n.
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=social.colibri.app

# Signs the Mark as read tokens every push carries, so a notification action can
# mark its channel read without a session. Unset, pushes carry no read action.
#   openssl rand -base64 32
# PUSH_ACTION_SECRET=

# GIF picker. Get a key from https://partner.klipy.com/
# KLIPY_API_KEY=

# Voice. SFU_ANNOUNCED_IP is required behind NAT, which is most cloud hosts.
# Each SFU worker listens on one UDP and TCP port, starting at SFU_RTC_PORT, so
# publish SFU_RTC_PORT up to SFU_RTC_PORT + SFU_WORKER_COUNT - 1. The worker
# count defaults to the number of CPUs.
# VOICE_ENABLED=true
# SFU_WORKER_COUNT=
# SFU_LISTEN_IP=0.0.0.0
# SFU_ANNOUNCED_IP=
# SFU_RTC_PORT=40000
# SFU_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"p"}]
# SFU_INITIAL_OUTGOING_BITRATE=3500000
# A call starts on one worker. Past this many participants per worker it takes
# another worker, up to SFU_WORKER_COUNT.
# SFU_PARTICIPANTS_PER_WORKER=20
#
# Cloudflare TURN. With both set, every transport gets its own relay
# credentials, valid for 24 hours, next to SFU_ICE_SERVERS.
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
#
# How long a call on a draining node keeps running before it moves to another
# voice node. Participants can move earlier.
# VOICE_MIGRATION_NOTICE_SECONDS=60

# Listening artwork. Cover Art Archive, MusicBrainz, Deezer and iTunes are
# always tried. Turn this on to also search YouTube, which is the only place
# fan uploads and game rips have any artwork at all.
# VIDEO_ARTWORK_ENABLED=false

# BLOB_CACHE_MAX_BYTES=268435456
# Rendered image previews kept on disk across restarts. 0 turns the disk cache off.
# BLOB_DISK_CACHE_DIR=./data/blob-cache
# BLOB_DISK_CACHE_MAX_BYTES=10737418240
# How many images the node resizes at once. Defaults to half the CPU cores.
# BLOB_RENDER_CONCURRENCY=
# SENTRY_DSN=
# Share of ordinary requests whose traces reach Sentry. Requests over 1 second and failed ones
# always do.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Prometheus metrics at http://METRICS_HOST:METRICS_PORT/metrics. 0 turns them off.
# METRICS_HOST=127.0.0.1
# METRICS_PORT=9464
# The main node sends an anonymous heartbeat once a day. Set either one to turn it off.
# COLIBRI_TELEMETRY_DISABLED=1
# DO_NOT_TRACK=1
# COLIBRI_TELEMETRY_URL=https://telemetry.colibri.social/v1/heartbeat
# ADMIN_PASSWORD=

# development only, read by docker-compose.pds.yml

# PDS_JWT_SECRET=
#   openssl ecparam -name secp256k1 -genkey -noout -outform DER | tail -c +8 | head -c 32 | xxd -p -c 32
# PDS_PLC_ROTATION_KEY=
# POSTGRES_PASSWORD=
